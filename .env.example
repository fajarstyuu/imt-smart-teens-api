# Local infrastructure convenience. Generate a password; never commit .env.
POSTGRES_DB=imt_smart_teens_dev
POSTGRES_USER=imt_dev
POSTGRES_PASSWORD=
POSTGRES_PORT=55432

# Rust runtime. Source environment privately before invoking the binary; no implicit .env load.
# DATABASE_URL: required PostgreSQL connection secret for DML-only runtime role.
# MIGRATION_DATABASE_URL: required ONLY for explicit migrate command, DDL role.
# TEST_DATABASE_URL: local operator convenience; SQLx tests read DATABASE_URL and create
# isolated owned databases. Never point tests at the application database.
DATABASE_URL=
MIGRATION_DATABASE_URL=
TEST_DATABASE_URL=
APP_ENV=development
HTTP_HOST=127.0.0.1
HTTP_PORT=4180
DATABASE_MAX_CONNECTIONS=5
DATABASE_ACQUIRE_TIMEOUT_SECS=3
DATABASE_STATEMENT_TIMEOUT_SECS=10
REQUEST_TIMEOUT_SECS=15
REQUEST_BODY_LIMIT_BYTES=65536
# Exact comma-separated browser origins, including same-origin deployments.
# Empty disables cross-origin access AND browser mutations until explicit origins are configured.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173
SESSION_IDLE_TTL_SECS=7200
SESSION_ABSOLUTE_TTL_SECS=604800
ADMIN_SESSION_ABSOLUTE_TTL_SECS=43200
SESSION_COOKIE_SECURE=false
# Required: cryptographically random secret with at least 32 bytes, no default.
CSRF_SIGNING_KEY=
SHUTDOWN_TIMEOUT_SECS=20
RUST_LOG=info

# Explicit private provision-admin command only, never public seed credentials.
# Supply password through a private environment/secret injection or noninteractive stdin.
# ADMIN_PASSWORD intentionally has no example value. CLI password arguments are refused.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
ADMIN_CAN_MANAGE_SCHOOLS=false
ADMIN_CAN_MANAGE_CONTENT=false
