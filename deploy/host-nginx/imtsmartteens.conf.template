# IMT production frontend; host owns TLS, container owns static SPA/API proxy.
server {
    listen 80;
    listen [::]:80;
    server_name imtsmartteens.my.id;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/imt-smart-teens-acme;
        try_files $uri =404;
    }
    location / { return 301 https://imtsmartteens.my.id$request_uri; }
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name imtsmartteens.my.id;
    ssl_certificate /etc/letsencrypt/live/imtsmartteens.my.id/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/imtsmartteens.my.id/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    server_tokens off;
    client_max_body_size 1m;
    add_header Strict-Transport-Security "max-age=86400" always;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/imt-smart-teens-acme;
        try_files $uri =404;
    }
    location / {
        proxy_pass http://127.0.0.1:5180;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Forwarded "";
        proxy_set_header Connection "";
        proxy_connect_timeout 3s;
        proxy_read_timeout 25s;
    }
}
